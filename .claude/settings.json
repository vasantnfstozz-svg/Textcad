{
  "permissions": {
    "allow": [
      "PowerShell(python studio.py)",
      "PowerShell(python engine.py)",
      "PowerShell(python inspector.py)",
      "PowerShell(python blocks.py)",
      "PowerShell(python assembly.py)",
      "PowerShell(python impeller.py *)",
      "PowerShell(python impeller.py)",
      "PowerShell(python meanline.py)",
      "PowerShell(python document.py)",
      "PowerShell(python author.py)",
      "PowerShell(python check.py)",
      "PowerShell(python generate.py *)",
      "PowerShell(python play.py *)",
      "PowerShell(python mcp_server.py)",
      "PowerShell(Get-Content *)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Select-String *)",
      "PowerShell(Test-Path *)",
      "PowerShell(Test-NetConnection *)",
      "PowerShell(Get-Command *)",
      "PowerShell(Get-Process *)",
      "PowerShell(Start-Sleep *)",
      "PowerShell(Invoke-RestMethod http://127.0.0.1*)",
      "PowerShell(Invoke-WebRequest http://127.0.0.1*)",
      "mcp__textcad__list_operations",
      "mcp__textcad__measure_step",
      "mcp__textcad__verify_step",
      "mcp__textcad__build_design",
      "mcp__textcad__design_part",
      "mcp__textcad__design_compressor"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Python314/python.exe \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect_designs.py\"",
            "timeout": 30,
            "statusMessage": "checking the design library is untouched"
          }
        ],
        "matcher": "Edit|Write"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Python314/python.exe \"$CLAUDE_PROJECT_DIR/.claude/hooks/no_force_push.py\"",
            "timeout": 30
          }
        ],
        "matcher": "Bash|PowerShell"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Python314/python.exe \"$CLAUDE_PROJECT_DIR/.claude/hooks/js_syntax_check.py\"",
            "timeout": 30,
            "statusMessage": "node --check"
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Python314/python.exe \"$CLAUDE_PROJECT_DIR/.claude/hooks/cache_buster_check.py\"",
            "timeout": 30,
            "statusMessage": "cache-buster check"
          }
        ]
      }
    ]
  }
}
